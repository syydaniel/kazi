    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
